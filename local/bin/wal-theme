#!/usr/bin/env sh
# wal-theme <image>: set the wallpaper with awww and retheme everything from
# its colours with pywal. Called by matuwall (command backend) on every pick.
#
# Generates:
#   ~/.config/hypr/theme.lua      - loaded by hyprland.lua via pcall(dofile)
#   ~/.config/waybar/colors.css   - imported by waybar's style.css
# then reloads both.

set -u
IMG="${1:-}"
[ -f "$IMG" ] || exit 1

awww img -a "$IMG" >/dev/null 2>&1

# -n: don't touch Xresources (wayland only), -q: quiet
wal -i "$IMG" -n -q 2>/dev/null || exit 0

WAL="$HOME/.cache/wal"
[ -f "$WAL/colors.json" ] || exit 0

python3 - "$WAL/colors.json" <<'PY'
import json, sys

c = json.load(open(sys.argv[1]))["colors"]
hx = c["color0"].lstrip("#")   # background
fg = c["color7"].lstrip("#")   # text
c1 = c["color1"].lstrip("#")   # accent (wal's first accent)
c8 = c["color8"].lstrip("#")   # dim

# --- hyprland theme.lua (consumed by hyprland.lua) ---
theme = f'''local theme = {{
\tname = "pywal",
\tlabel = "Pywal (wallpaper)",
\tactive_border = "rgba({c1}ff)",
\tinactive_border = "rgba({hx}ff)",
\tshadow_color = "0xee{hx}",
}}
return theme
'''
open("/home/water/.config/hypr/theme.lua", "w").write(theme)

# --- waybar colors.css ---
css = f"""/* Generated by wal-theme from the wallpaper. Do not edit. */

@define-color base          #{hx};
@define-color text          #{fg};
@define-color subtext       #{c8};

@define-color bg1           #{hx};
@define-color bg2           #{c8};
@define-color bg3           #{c8};
@define-color bg4           #{fg};
@define-color bg            #{hx};
@define-color fg            #{fg};
@define-color overlay2      #{fg};
@define-color overlay1      #{c8};
@define-color overlay0      #{c8};
@define-color ws_inactive   #{c8};
@define-color ws_active     #{fg};
@define-color urgent        #{c1};
@define-color tooltip_bg    #{hx};
@define-color tooltip_border #{c8};
@define-color battery_warn  #{c1};
@define-color battery_crit  #{c1};
@define-color cpucat        #{c8};
@define-color island        alpha(@base, 0.85);
@define-color island_hover  alpha(@bg2, 0.9);
"""
open("/home/water/.config/waybar/colors.css", "w").write(css)
print("  colours generated")
PY

hyprctl reload >/dev/null 2>&1
pkill -USR2 -x waybar 2>/dev/null || {
    pkill -x waybar 2>/dev/null
    "$HOME/.local/bin/toggle-waybar" >/dev/null 2>&1
}
