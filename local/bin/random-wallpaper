#!/usr/bin/env bash
set -euo pipefail

WALLPAPER_DIR="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
STATE="$HOME/.local/state/matuwall/last-selection"

REAL_DIR="$(readlink -f "$WALLPAPER_DIR" 2>/dev/null || printf '%s' "$WALLPAPER_DIR")"

mapfile -t files < <(
	find "$REAL_DIR" -maxdepth 1 -type f \
		\( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.webp' \) \
		-print
)

[ "${#files[@]}" -gt 0 ] || exit 0

current="$(basename "$(cat "$STATE" 2>/dev/null || true)")"
candidates=()
for f in "${files[@]}"; do
	[ "$(basename "$f")" = "$current" ] || candidates+=("$f")
done
[ "${#candidates[@]}" -gt 0 ] || candidates=("${files[@]}")

pick="${candidates[$((RANDOM % ${#candidates[@]}))]}"

awww img --transition-type grow --transition-pos center \
	--transition-duration 1.2 --transition-fps 60 "$pick"

mkdir -p "$(dirname "$STATE")"
printf '%s\n' "$WALLPAPER_DIR/$(basename "$pick")" > "$STATE"
