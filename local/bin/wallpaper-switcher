#!/usr/bin/env bash
#
# Wallpaper switcher: opens qs-wallpaperpicker's Wallhaven browser.
#
#   wallpaper-switcher          open the picker
#   wallpaper-switcher wallhaven  open it on the Wallhaven source
#   wallpaper-switcher set FILE   apply a specific wallpaper
#
# Uses https://github.com/dhrruvsharma/qs-wallpaperpicker, installed at
# ~/.config/qs-wallpaperpicker with its CLI at ~/.local/bin/qs-wallpaperpicker.
# That project is standalone Quickshell, so it needs no bar daemon of its own -
# waybar keeps the bar.
#
# Wallhaven withholds results from its bare "top list" query unless an API key is
# supplied, so a keyless install opens that tab to nothing. A seed is generated
# automatically to work around it; entering a free key in the picker's own
# settings is the better fix and removes the need for that.

set -uo pipefail

exec qs-wallpaperpicker "${1:-wallhaven}"
