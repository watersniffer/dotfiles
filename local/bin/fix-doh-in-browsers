#!/usr/bin/env bash

# Disable DNS-over-HTTPS in every Firefox-family profile, so that DNS actually
# goes through the local dnsmasq (and therefore the porn blocklist).
#
# WHY THIS IS REQUIRED:
# /etc/hosts and dnsmasq are both DNS-level controls. DoH has the browser send
# hostnames straight to a DoH resolver over HTTPS, never touching the system
# resolver at all - so the blocklist is bypassed entirely.
#
# LibreWolf in particular defaults to network.trr.mode = 5 (DoH-only, no
# fallback) and privacy.resistFingerprinting forces it back on. Setting
# network.trr.mode = 0 in user.js overrides that, because user.js is applied
# after the built-in defaults.
#
# TRADE-OFF: turning DoH off means DNS queries are visible to your ISP/resolver
# (Cloudflare here) and are not encrypted. That is the price of host-level
# blocking. If privacy matters more than blocking, set trr.mode = 2 instead
# (DoH with fallback) - but then the blocklist only applies when DoH fails.
#
# Re-run after creating a new profile. Requires the browser to be RESTARTED for
# user.js changes to take effect.

set -uo pipefail

marker="# --- porn blocklist: force system DNS so dnsmasq sees the traffic ---"

targets=()
for root in "$HOME/.config/librewolf" "$HOME/.librewolf" "$HOME/.zen" "$HOME/.mozilla/firefox"; do
    [ -d "$root" ] || continue
    # Path= values inside profiles.ini are RELATIVE to the ini's own directory,
    # so join them there - not to $PWD.
    while IFS= read -r ini; do
        d=$(dirname "$ini")
        while IFS= read -r rel; do
            [ -n "$rel" ] && targets+=("$d/$rel")
        done < <(grep -E '^Path=' "$ini" | cut -d= -f2-)
    done < <(find "$root" -maxdepth 3 -name profiles.ini 2>/dev/null)
done

# De-dup.
mapfile -t targets < <(printf '%s\n' "${targets[@]}" | sort -u)

if [ ${#targets[@]} -eq 0 ]; then
    echo "fix-doh-in-browsers: no Firefox-family profiles found" >&2
    exit 0
fi

for dir in "${targets[@]}"; do
    [ -d "$dir" ] || continue
    uj="$dir/user.js"

    if [ -f "$uj" ] && grep -q "network.trr.mode" "$uj"; then
        echo "fix-doh-in-browsers: already set in $uj" >&2
        continue
    fi

    {
        echo ""
        echo "$marker"
        echo "# 0 = off -> use the system resolver (dnsmasq), so /etc/hosts.porn applies."
        echo '# user_pref("network.trr.mode", 2);   # alternative: DoH + fallback (weaker blocking)'
        echo 'user_pref("network.trr.mode", 0);'
    } >> "$uj"

    echo "fix-doh-in-browsers: patched $uj" >&2
done

echo "fix-doh-in-browsers: done - RESTART the browser for this to apply" >&2
