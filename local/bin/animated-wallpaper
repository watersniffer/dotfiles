#!/usr/bin/env bash

# Video wallpaper switcher. Bound to Super+N in hyprland.lua.
#
#   animated-wallpaper                 pick a random video and play it
#   animated-wallpaper --toggle-sound  mute/unmute the running video
#
# Videos live next to the stills under ~/Pictures/Wallpapers; add subfolders
# or pass a folder to scope the random pick, matching wallpaper-switcher.
# mpvpaper runs the video on the background shell surface, so it sits behind
# the awww still until a video is started.

set -uo pipefail

WALL_ROOT="$HOME/Pictures/Wallpapers"
OUTPUT="eDP-1"

toggle_sound() {
    local sock=/tmp/mpvpaper-sock
    if ! pgrep -x mpvpaper >/dev/null 2>&1; then
        printf 'animated-wallpaper: no video running\n' >&2
        exit 0
    fi

    # Ask mpv over its JSON IPC socket whether it is currently muted, then flip.
    local state
    state=$(printf '{"command":["get_property","mute"]}\n' \
        | timeout 2 socat - "UNIX-CONNECT:$sock" 2>/dev/null \
        | grep -o '"data":\(true\|false\)' | head -1 | grep -o 'true\|false')

    if [[ $state == "false" ]]; then
        printf '{"command":["set_property","mute","yes"]}\n' | socat - "UNIX-CONNECT:$sock" >/dev/null 2>&1
        printf 'animated-wallpaper: sound off\n' >&2
    else
        printf '{"command":["set_property","mute","no"]}\n' | socat - "UNIX-CONNECT:$sock" >/dev/null 2>&1
        printf 'animated-wallpaper: sound on\n' >&2
    fi
    exit 0
}

if [[ ${1:-} == "--toggle-sound" ]]; then
    toggle_sound
fi

stop_video() {
    pkill -x mpvpaper 2>/dev/null
    printf 'animated-wallpaper: stopped\n' >&2
}

if [[ ${1:-} == "--stop" ]]; then
    stop_video
    exit 0
fi

# Pick a random video from the given folder (default: all of Wallpapers).
folder=${1:-}
if [[ -n $folder ]]; then
    if [[ $folder == /* ]]; then
        dir=$folder
    else
        dir="$WALL_ROOT/$folder"
    fi
else
    dir="$WALL_ROOT"
fi

if [[ ! -d $dir ]]; then
    printf "animated-wallpaper: '%s' does not exist\n" "$dir" >&2
    exit 1
fi

mapfile -t videos < <(find "$dir" -type f \
    \( -iname '*.mp4' -o -iname '*.webm' -o -iname '*.mkv' -o -iname '*.mov' \) \
    2>/dev/null)

if [[ ${#videos[@]} -eq 0 ]]; then
    printf 'animated-wallpaper: no videos in %s\n' "$dir" >&2
    printf '  (put .mp4/.webm/.mkv/.mov files under %s)\n' "$WALL_ROOT" >&2
    exit 1
fi

video=${videos[RANDOM % ${#videos[@]}]}

# Replace any running video, then start this one: loop, no audio (mute by
# default so it does not fight with pulseaudio; Super+Shift+N unmutes).
pkill -x mpvpaper 2>/dev/null
sleep 0.3
# -s auto-stops mpv when fully covered (saves CPU on this laptop); -a full = stop
# on any fullscreen/maximized window. "no-audio" mutes by default.
mpvpaper -f -s -a full -o "no-audio loop" -o "input-ipc-server=/tmp/mpvpaper-sock" \
    "$OUTPUT" "$video" >/dev/null 2>&1
printf 'animated-wallpaper: playing %s\n' "$video" >&2
