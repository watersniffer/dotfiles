#!/usr/bin/env bash

# Krita launcher that fixes the glitched UI.
#
# Krita is a Qt6 / KDE Frameworks 6 app, and the session-wide Qt env vars that
# look fine in GTK/lightweight Qt apps were making its interface render badly:
#
#   QT_STYLE_OVERRIDE=kvantum  — Kvantum themes are not compatible with KF6
#                                widgets, so panels/menus came out misaligned.
#   QT_SCALE_FACTOR=0.90       — fractional scale. Tried both with and without
#                                QT_SCALE_FACTOR_ROUNDING_POLICY=PassThrough and
#                                KF6/Krita still laid out wrong at 1366x768, so
#                                Krita runs at integer 1.0 instead. Other Qt apps
#                                keep the session-wide 0.90.
#
# So: drop Kvantum, render at integer 1.0, and use the PROPORTIONAL Iosevka.
# qt6ct is kept, since that is what applies the AMOLED colours.

unset QT_STYLE_OVERRIDE
export QT_FONT_FAMILY="Iosevka Nerd Font Propo"
export QT_SCALE_FACTOR=1
export QT_QPA_PLATFORMTHEME=qt6ct

exec /usr/bin/krita "$@"
