[Unit]
Description=KWallet daemon 6 (compatibility wrapper over Secret Service)
Documentation=https://api.kde.org/frameworks/kwallet/html/index.html
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/kwalletd6
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
