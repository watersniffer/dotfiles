// Custom modules for the V1.5 layout.
{

    // cava visualiser (https://github.com/ray-pH/waybar-cava) — bars only, so
    // it pairs with the mpris module next to it without duplicating its text.
    "custom/cava": {
        "format": "{}",
        "exec": "$HOME/.config/waybar/scripts/cava.sh",
        "escape": false
    },

    "custom/separator#dot": {
        "format": "",
        "interval": "once",
        "tooltip": false
    },
    "custom/separator#line": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },
    "custom/separator#blank": {
        "format": " ",
        "interval": "once",
        "tooltip": false
    },
    "custom/separator#aright": {
        "format": "",
        "tooltip": false
    },
    "custom/separator#aleft": {
        "format": "",
        "tooltip": false
    }
}
