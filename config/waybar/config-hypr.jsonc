// Main bar.
{
    "include": [
        "$HOME/.config/waybar/Modules",
        "$HOME/.config/waybar/ModulesCustom"
    ],

    "name": "main",
    "reload_style_on_change": false,
    "layer": "top",
    "position": "top",
    "margin": "1px",
    "spacing": 0,
    "height": 24,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": [
        "group/right"
    ],

    // One continuous pill holding every right-side module, instead of
    // separate floating islands.
    "group/right": {
        "orientation": "horizontal",
        "modules": [
            "tray",
            "pulseaudio",
            "backlight/slider",
            "battery",
            "clock"
        ]
    }
}
