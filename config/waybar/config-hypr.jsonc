// Main bar.
{
    "include": [
        "$HOME/.config/waybar/Modules",
        "$HOME/.config/waybar/ModulesCustom"
    ],

    "name": "main",
    "reload_style_on_change": false,
    "layer": "top",
    "position": "top",
    "margin": "1px",
    "spacing": 0,
    "height": 24,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["mpris"],
    "modules-right": [
        "pulseaudio",
        "backlight",
        "battery",
        "custom/mako",
        "custom/power",
        "clock"
    ]
}
