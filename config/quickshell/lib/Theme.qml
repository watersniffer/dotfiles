import QtQml
import QtQuick
pragma Singleton

// Colour + metrics ported 1:1 from ~/.config/waybar/colors.css and style.css so
// the Quickshell bar is visually identical to the waybar bar it replaces.
// colors.css is generated by wal-theme from the wallpaper - keep them in sync.

QtObject {
    readonly property color base:     "#0b0b11"  // @base  pill background
    readonly property color text:     "#bfbcc7"  // @text  primary text / accent
    readonly property color subtext:  "#85838b"  // @subtext

    readonly property color bg3:      "#85838b"  // @bg3    slider trough
    readonly property color urgent:    "#5E6276"

    // Bar metrics, matching the waybar config (height 24, margin 1px).
    readonly property int barHeight: 24
    readonly property int barMargin: 1
    readonly property int pillRadius: 6
    readonly property int fontSize: 10
    readonly property string fontFamily: "Iosevka Nerd Font"
}
