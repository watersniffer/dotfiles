;; --- Listeners & Polls ---
;;
;; Every playerctl call goes through ~/.local/bin/playerctl-pinned rather than
;; bare playerctl. With more than one player registered (spotify AND a browser),
;; bare playerctl latches onto a PAUSED player and ignores the playing one, and
;; errors with "No player could handle this command" when its pick disappears -
;; error text that used to end up in the title. playerctl-pinned pins every call
;; to music-player-select, which prefers whichever player is actually Playing.
;;
;; The `grep -v 'No player could handle'` guards are a second line of defence so
;; that error string can never reach the widget, even if the pinned call fails.
;;
;; --line-buffered is REQUIRED, not cosmetic. `playerctl --follow` emits one
;; line per track change, so output arrives in bursts; grep block-buffers when
;; stdout is a pipe (4-8KB) and never flushes in time, so the widget sat on
;; "No Music Playing" while the correct title was already coming through.
;; Verified: without it the pipeline yields nothing, with it it yields
;; "Don't Copy My Flow".
;;
;; Use `deflisten` with `--follow` to react to player events efficiently.
(deflisten song_title    :initial "No Music Playing"
"playerctl-pinned metadata --format '{{title}}' --follow 2>/dev/null | grep --line-buffered -v 'No player could handle' | python3 $HOME/.config/eww/music-widget/scroll.py 22 0.3 || echo 'No Music Playing'")

(deflisten song_artist   :initial "Unknown Artist"
"playerctl-pinned metadata --format '{{artist}}' --follow 2>/dev/null | grep --line-buffered -v 'No player could handle' | python3 $HOME/.config/eww/music-widget/scroll.py 25 0.3 || echo 'Unknown Artist'")

(deflisten player_status :initial "Stopped"
"playerctl-pinned metadata --format '{{status}}' --follow 2>/dev/null | grep --line-buffered -v 'No player could handle' || echo 'Stopped'")

(defpoll song_length_s   :initial "1" :interval "2s"
"playerctl-pinned metadata mpris:length 2>/dev/null | awk '{print int($1 / 1000000)}' || echo 1")

(defpoll song_position_s    :initial "0" :interval "1s" "playerctl-pinned position 2>/dev/null || echo 0")

(defpoll formatted_position :initial "0:00" :interval "1s" "playerctl-pinned position -f '{{duration(position)}}' 2>/dev/null || echo '0:00'")

(defpoll cover_art_path :interval "1s" "$HOME/.config/eww/music-widget/get-cover.sh")

;; NOTE: the volume column (vol_icon mute button + vertical slider) was removed
;; from this widget. It duplicated the speaker module already in the waybar
;; right-hand group, and scrolling volume there works fine.
;; volumecontroller.sh is kept for the waybar module; volume_percent and
;; volume_mute are no longer polled here, which drops two more polls.

;; NOTE: cava was removed from this widget on purpose. It ran as a `deflisten`
;; that shelled out to a long-running `cava` process streaming ASCII bars, and
;; measured 48% CPU with the widget open versus ~0% closed. waybar's own
;; custom/cava module already provides a visualiser in the bar, so having a
;; second independent cava instance here was pure duplicated work.

;; --- Widget Definition ---

(defwidget music-widget []
  (box :class "music-widget" :orientation "h" :space-evenly false
    
    ;; Left: Cover Art
    (box :class "cover-art" :style "background-image: url('${cover_art_path}');")
    
    ;; Middle: Info & Controls
    (box :class "music-info" :orientation "v" :space-evenly false :valign "center"
      (label :class "song-title" :text song_title :halign "start")
      (label :class "artist" :text song_artist :halign "start")
      


      (box :class "progress-container" :orientation "v" :space-evenly false
        (label :class "position" :text formatted_position :halign "start")
        (scale :class "progress-bar" 
               :min 0 
               :max song_length_s 
               :value song_position_s )
      )



      (box :class "controls" :orientation "h" :space-evenly false :halign "center" :spacing 15
        (button :onclick "playerctl-pinned previous" :tooltip "Previous" "󰒮")
        (button :onclick "playerctl-pinned play-pause" :tooltip "Play/Pause" :class "play-btn" {player_status == "Playing" ? "󰏤" : "󰐊"})
        (button :onclick "playerctl-pinned next" :tooltip "Next" "󰒭")
        (button :onclick "eww -c ~/.config/eww close music-widget" :tooltip "Close" :class "close-btn" "")
      )

    )
  )
)

;; --- Window Definition ---

  (defwindow music-widget
    :monitor 0
    :geometry (
      ;; Centred under the bar: the panel is 1366 wide, the media module is in
      ;; modules-center so it sits at x=683, and a 460px widget centred on that
      ;; starts at 453.
      ;; :y is relative to waybar's exclusive zone (measured: rendered y = :y + 26),
      ;; so :y "0px" lands the widget at y=26 — 1px below the 24px bar.
      geometry :x "453px"
               :y "0px"
               :width "460px"
               :height "160px"
  )
  ;; :focusable is left false so the widget never steals the keyboard from the
  ;; window you are working in. Closing is done with the waybar media module
  ;; (click it again), the ✕ button, or Super+W — no click-catcher layer.
  :wm-ignore true
  (music-widget)
)

