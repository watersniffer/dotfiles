# AMOLED: black panel, one light accent. Fixed, no pywal.
font=JetBrainsMono Nerd Font 9
background-color=#000000
text-color=#d7d6df
border-color=#d7d6df
border-size=2
border-radius=10
padding=12
margin=8
default-timeout=5000
width=360
icons=1
max-icon-size=64
text-alignment=left

[urgency=low]
background-color=#000000
text-color=#9a9a94
border-color=#333333
default-timeout=4000

[urgency=normal]
background-color=#000000
text-color=#d7d6df
border-color=#d7d6df
default-timeout=6000

[urgency=critical]
background-color=#d7d6df
text-color=#000000
border-color=#d7d6df
